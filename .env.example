# Copy this file to ".env" and fill in your values.
# NEVER commit .env to GitHub - it holds your secrets. (.gitignore already blocks it.)
# With everything empty, the app runs in DEMO MODE (sample Razorpay disputes + offline AI).

# --- Razorpay TEST MODE (Dashboard -> switch to Test Mode -> Account & Settings -> API Keys)
# Test keys start with rzp_test_. Leave empty for demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> Add: URL https://your-app.onrender.com/webhooks/razorpay, events payment.dispute.*,
# and a secret you choose. Put the same secret here.
RAZORPAY_WEBHOOK_SECRET=

# --- AI model (any OpenAI-compatible API). We use NVIDIA Nemotron served by Nebius.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
# Any model id your provider lists
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional: switches on the Insights dashboard agent. Tested with this model on Nebius.
AGENT_MODEL=zai-org/GLM-5.3
# To switch to Gemini later, only change the 3 lines above, e.g.:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-model-id

# --- Seller rules (enforced by code, not AI)
SETTLE_MAX_INR=2000
MAX_OFFER_PCT=50

# --- Dashboard login (REQUIRED once the app is on the internet)
ADMIN_USER=seller
ADMIN_PASSWORD=

# Re-check open disputes with Razorpay every N minutes (0 = off)
WATCH_MINUTES=5
# Demo mode only: put the sample cases back this many minutes after a visitor's last change (0 = off)
DEMO_RESET_MINUTES=30
# Most AI team runs per hour from the web page, to protect your AI credits (0 = no limit)
AI_RUNS_PER_HOUR=30

# Local testing only: accept webhooks without a PayPal signature
ALLOW_UNVERIFIED_WEBHOOKS=false

# Gnani (Vachana) speech AI: call recordings -> text, and Hinglish voice briefs. Leave empty to paste transcripts only.
GNANI_API_KEY=
# GNANI_LANGUAGE=hi-IN,en-IN     (Hindi, English, or both mixed in one call)
# GNANI_FORMAT=transliterate     (Hindi words written in Latin letters: "parcel aa gaya")
# GNANI_TTS_VOICE=Poorvi         (Gnani's Hinglish voice; GNANI_TTS_LANGUAGE=hi-en)
